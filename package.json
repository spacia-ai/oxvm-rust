{
  "name": "oxvm-rust",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "oxvm wasm build",
    "check": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p scripts && eslint . --max-warnings 0 && oxvm wasm build --check",
    "release": "oxvm wasm release",
    "test": "vitest run",
    "test:conformance": "oxvm wasm build && oxvm wasm test --arg=--exit --arg=0",
    "build:rust": "node scripts/build-wasm.ts",
    "inspect:fixtures": "node scripts/inspect-fixtures.ts",
    "test:browser": "node test/browser/run.ts",
    "release:check": "node scripts/release-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@oxvm/cli": "0.0.33",
    "@oxvm/sdk": "0.0.33",
    "@types/node": "24.13.3",
    "eslint": "10.7.0",
    "playwright": "1.64.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
